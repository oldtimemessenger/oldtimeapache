{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx ./scripts/cloudflare-preview-gateway.mjs",
    "build": "wrangler deploy --dry-run --config ./wrangler.toml",
    "start": "pnpm run dev",
    "cloudflare:dev": "pnpm run dev",
    "cloudflare:d1:migrate:local": "wrangler d1 migrations apply oldtime-app --local --config ./wrangler.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.mjs test/*.test.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jose": "6.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "wrangler": "^4.152.0",
    "ws": "^8.22.0"
  }
}
