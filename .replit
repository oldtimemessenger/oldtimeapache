modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_WqFMDjPqFmGJBIrFYqRbYdIfIFE"
REVENUECAT_IOS_APP_ID = "app4b7c881c4f"
REVENUECAT_PROJECT_ID = "proj2b9a6899"
